@model System.Data.DataTable
@using System.Data
@using WebApplication1.Filters
@using WebApplication1.Models
@{
    bool soloLectura = Permisos.EsSoloLectura(Session["SessionUser"] as SessionModels, "CategoriasTarifa", "CategoriasTarifa");
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>
    .btn-outline-custom {
        border-radius: 20px;
        border: 1px solid #cbd5e1;
        color: #475569;
        font-size: 0.85rem;
        font-weight: 500;
        padding: 4px 16px;
        text-decoration: none;
        display: inline-block;
    }

        .btn-outline-custom:hover {
            background-color: #f8fafc;
            color: #1e293b;
        }
</style>
<div class="ui container fluid" style="padding: 15px;">
    <div class="ui grid stackable middle aligned">
        <div class="eight wide column">
            <h3 class="ui header">
                <i class="tags icon"></i>
                <div class="content">
                    Categorías de Tarifas Administrativas
                    <div class="sub header">Listado general de categorías</div>
                </div>
            </h3>
        </div>
        <div class="eight wide right aligned column">
            @if (!soloLectura)
            {
                <a href="javascript:void(0)"
                   class="btn-outline-custom"
                   onclick="cargarElement('@Url.Action("Registrar", "CategoriasTarifa")')">
                    <i class="bi bi-plus-lg me-1"></i> Crear Categoría
                </a>
            }
            else
            {
                <span class="ui small label"><i class="lock icon"></i> Modo consulta</span>
            }
        </div>
    </div>

    <div class="ui divider"></div>

    <table class="ui selectable celled table center aligned tablesInitial" id="tablaCategoriasTarifa">
        <thead>
            <tr>
                <th class="collapsing">Id</th>
                <th>Nombre</th>
                <th class="collapsing">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || Model.Rows.Count == 0)
            {
                <tr>
                    <td colspan="3" class="center aligned text-muted">No se encontraron categorías de tarifa.</td>
                </tr>
            }
            else
            {
                foreach (DataRow row in Model.Rows)
                {
                    <tr>
                        <td>
                            <a href="javascript:void(0)"
                               class="ui mini blue label"
                               onclick="cargarElement('@Url.Action("Perfil", "CategoriasTarifa", new { id = row["Id"].ToString() })')">
                                @row["Id"]
                            </a>
                        </td>
                        <td class="left aligned">@row["Nombre"]</td>
                        <td>
                            <button class="ui mini basic icon button"
                                    title="Editar Categoría"
                                    onclick="cargarElement('@Url.Action("Registrar", "CategoriasTarifa", new { id = row["Id"].ToString() })')">
                                <i class="edit outline icon"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script type="text/javascript">
    function cargarElement(url) {
        $.ajax({
            url: url,
            beforeSend: function () {
                $('#facadeContent').html('').addClass("loading").css("height", 500);
            },
            success: function (data) {
                $('#facadeContent').html(data);
            },
            complete: function () {
                $('#facadeContent').removeClass("loading").css("height", "inherit");
                LoadElementsDefaultPartial('#facadeContent');
            }
        });
    }
</script>
