<script type="text/javascript">
    // Habilita la lista de Tarjetas de Crédito TA solo cuando la Forma de Pago TA es "Tarjeta de Crédito"
    // La vista se inyecta por AJAX varias veces: se quitan los manejadores anteriores para no duplicar llamadas
    $(document).off('.autorizacion');
    $(document).on('change.autorizacion', 'select[name="cbxFPTA"]', function () {
        var $sel = $(this);
        var $tr = $sel.closest('tr');
        var $tc = $tr.find('select[name="cbxTCTA"]');
        if ($tc.length === 0 || $tc.hasClass('deshabilitado-por-estado')) return;

        var texto = ($sel.find('option:selected').text() || '').toLowerCase();
        var esTarjeta = texto.indexOf('tarjeta') !== -1;

        $tc.prop('disabled', !esTarjeta);
        $tc.closest('.ui.dropdown').toggleClass('disabled', !esTarjeta);

        if (!esTarjeta) {
            // Limpia la selección y cualquier marca de error previa
            $tc.val('');
            if ($tc.closest('.ui.dropdown').length) { try { $tc.closest('.ui.dropdown').dropdown('clear'); } catch (e) { } }
            $tc.removeClass('campo-error').removeAttr('title');
            $tc.closest('td').removeClass('error').removeAttr('data-tooltip data-position data-variation');
        }
    });
</script>

<script type="text/javascript">
    // Al elegir una tarifa asignada al cliente: llena "Tarifa TA" y calcula "IVA TA" (19%)
    $(document).on('change.autorizacion', 'select[name="cbxTarifasAsignadas"]', function () {
        var $tr = $(this).closest('tr');
        var $tarifa = $tr.find('input[name="txbTarifaTA"]');
        var $iva = $tr.find('input[name="txbIVATarifaTA"]');
        if ($tarifa.length === 0 || $tarifa.is(':disabled')) return;

        var valor = parseFloat($(this).val());
        if (isNaN(valor)) return;

        function moneda(n) {
            return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        var $total = $tr.find('input[name="txbTotalTarifaTA"]');
        var iva = Math.round(valor * 19) / 100;

        $tarifa.val(moneda(valor)).trigger('change');
        if ($iva.length > 0 && !$iva.is(':disabled')) {
            $iva.val(moneda(iva)).trigger('change');
        }
        // Total tarifa TA = Tarifa TA + IVA TA
        if ($total.length > 0 && !$total.is(':disabled')) {
            $total.val(moneda(valor + iva)).trigger('change');
        }
    });
</script>

<script type="text/javascript">
    // Guardar (Autorizar) por fila: valida los campos obligatorios y marca el expediente como Autorizado
    (function () {
        function aNumero(txt) {
            return parseFloat((txt || '').toString().replace(/[^0-9.-]+/g, '')) || 0;
        }

        function toast(mensaje, exito) {
            var $t = $('<div style="position: fixed; top: 25px; right: 25px; z-index: 999999; color: white; ' +
                'padding: 15px 25px; border-radius: 8px; box-shadow: 0px 4px 12px rgba(0,0,0,0.3); ' +
                'font-family: sans-serif; font-size: 14px; max-width: 420px; background-color: ' + (exito ? '#21ba45' : '#db2828') + ';">' +
                '<i class="' + (exito ? 'check circle' : 'exclamation triangle') + ' icon"></i> <span></span></div>');
            $t.find('span').text(mensaje);
            $('body').append($t);
            setTimeout(function () { $t.fadeOut(400, function () { $t.remove(); }); }, exito ? 3000 : 5000);
        }

        function marcar($el, mensaje) {
            var $td = $el.closest('td');
            $el.addClass('campo-error').attr('title', mensaje);
            $td.addClass('error');
        }

        function limpiarMarcas($tr) {
            $tr.find('.campo-error').removeClass('campo-error').removeAttr('title');
            $tr.find('td.error').removeClass('error');
        }

        $(document).on('click.autorizacion', '#tablesIndexDocumentacion .btn-guardar-fila', function (e) {
            e.preventDefault();
            var $btn = $(this);
            if ($btn.is(':disabled') || $btn.hasClass('loading')) return;
            var $tr = $btn.closest('tr');
            limpiarMarcas($tr);

            var $fp = $tr.find('select[name="cbxFPTA"]');
            var $tc = $tr.find('select[name="cbxTCTA"]');
            var $tarifaAsignada = $tr.find('select[name="cbxTarifasAsignadas"]');
            var $tarifa = $tr.find('input[name="txbTarifaTA"]');
            var $iva = $tr.find('input[name="txbIVATarifaTA"]');
            var $total = $tr.find('input[name="txbTotalTarifaTA"]');
            var $pedido = $tr.find('input[name="txbPedido"]');
            var $voucher = $tr.find('input[name="txbVoucherAgencia"]');
            var $autAgencia = $tr.find('input[name="txbAutAgencia"]');

            var errores = [];
            function vacio(v) { v = (v === null || v === undefined) ? '' : v.toString().trim(); return v === '' || v === '0'; }

            // 1. Forma de pago TA (y tarjeta si corresponde)
            var textoFp = ($fp.find('option:selected').text() || '').toLowerCase();
            var esTarjeta = textoFp.indexOf('tarjeta') !== -1;
            if (vacio($fp.val())) {
                marcar($fp, 'Forma de pago TA es requerida'); errores.push('Forma de Pago TA');
            } else if (esTarjeta && vacio($tc.val())) {
                marcar($tc, 'Seleccione la tarjeta de crédito'); errores.push('Número Tarjeta Crédito TA');
            }

            // 2. Tarifa asignada al cliente
            var sinTarifas = $tarifaAsignada.attr('data-sin-tarifas') === '1';
            if (!sinTarifas && vacio($tarifaAsignada.val())) {
                marcar($tarifaAsignada, 'Seleccione una tarifa asignada al cliente'); errores.push('Tarifa asignada al cliente');
            }

            // 3. Tarifa TA, IVA y Total pobladas
            [[$tarifa, 'Tarifa TA'], [$iva, 'Iva Tarifa TA'], [$total, 'Total tarifa TA']].forEach(function (c) {
                if (aNumero(c[0].val()) <= 0) { marcar(c[0], c[1] + ' es requerido'); errores.push(c[1]); }
            });

            // 4. Pedido agencia
            if (vacio($pedido.val())) { marcar($pedido, 'Pedido Agencia es requerido'); errores.push('Pedido Agencia'); }

            // 5. Con tarjeta de crédito: voucher y autorización agencia
            if (esTarjeta) {
                if (vacio($voucher.val())) { marcar($voucher, 'Voucher Agencia es requerido'); errores.push('Voucher Agencia'); }
                if (vacio($autAgencia.val())) { marcar($autAgencia, 'Autorización Agencia es requerida'); errores.push('Autorización Agencia'); }
            }

            if (errores.length > 0) {
                toast('Complete los campos obligatorios: ' + errores.join(', '), false);
                return;
            }

            var dataFila = {
                FileId: $btn.data('file-id'),
                CustomerId: $btn.data('customer-id'),
                FileDetailID: $btn.data('filedetail-id'),
                PaymentMethodId: $fp.val(),
                PaymentCardId: esTarjeta ? $tc.val() : '0',
                FareTA: aNumero($tarifa.val()),
                IVATA: aNumero($iva.val()),
                FareWithTaxes: aNumero($total.val()),
                TarifaAsignada: $tarifaAsignada.val(),
                SinTarifasAsignadas: sinTarifas,
                PedidoAgencia: $pedido.val(),
                VoucherAgencia: $voucher.val(),
                AutorizacionAgencia: $autAgencia.val()
            };

            $.ajax({
                url: '@Url.Action("GuardarAutorizacionFila", "Inspections")',
                type: 'POST',
                data: JSON.stringify(dataFila),
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                beforeSend: function () { $btn.addClass('loading disabled'); },
                success: function (response) {
                    $btn.removeClass('loading');
                    if (response.success) {
                        $tr.find('.celda-estado').text('Autorizado');
                        $btn.removeClass('primary').addClass('disabled').prop('disabled', true)
                            .html('<i class="check icon"></i> Guardado');
                        // Bloquea la fila ya autorizada
                        $tr.find('select, input').prop('disabled', true);
                        $tr.find('.ui.dropdown').addClass('disabled');
                        toast('Expediente Autorizado', true);
                    } else {
                        $btn.removeClass('disabled');
                        toast(response.message || 'No se pudo guardar el registro.', false);
                    }
                },
                error: function (xhr, status, error) {
                    $btn.removeClass('loading disabled');
                    toast('Error de comunicación con el servidor: ' + error, false);
                }
            });
        });
    })();
</script>

<script type="text/javascript">
    // Clientes sin tarifas asignadas: la Tarifa TA se digita (solo números) y se calculan IVA (19%) y Total
    (function () {
        function filaSinTarifas($input) {
            var $s = $input.closest('tr').find('select[name="cbxTarifasAsignadas"]');
            return $s.attr('data-sin-tarifas') === '1';
        }
        function moneda(n) {
            return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        function aNumero(txt) {
            return parseFloat((txt || '').toString().replace(/[^0-9.]+/g, '')) || 0;
        }

        // Solo dígitos y un punto decimal; recalcula IVA y Total mientras se digita
        $(document).on('input.autorizacion', 'input[name="txbTarifaTA"]', function () {
            var $in = $(this);
            if ($in.is(':disabled') || !filaSinTarifas($in)) return;

            var limpio = $in.val().replace(/[^0-9.]/g, '');
            var partes = limpio.split('.');
            if (partes.length > 2) limpio = partes[0] + '.' + partes.slice(1).join('');
            if (limpio !== $in.val()) $in.val(limpio);

            var valor = parseFloat(limpio) || 0;
            var iva = Math.round(valor * 19) / 100;
            var $tr = $in.closest('tr');
            $tr.find('input[name="txbIVATarifaTA"]').val(valor > 0 ? moneda(iva) : '');
            $tr.find('input[name="txbTotalTarifaTA"]').val(valor > 0 ? moneda(valor + iva) : '');
        });

        // Al entrar al campo se muestra el número plano; al salir se formatea como moneda
        $(document).on('focus.autorizacion', 'input[name="txbTarifaTA"]', function () {
            var $in = $(this);
            if ($in.is(':disabled') || !filaSinTarifas($in)) return;
            var n = aNumero($in.val());
            $in.val(n > 0 ? n.toString() : '');
        });
        $(document).on('blur.autorizacion', 'input[name="txbTarifaTA"]', function () {
            var $in = $(this);
            if ($in.is(':disabled') || !filaSinTarifas($in)) return;
            var n = aNumero($in.val());
            $in.val(n > 0 ? moneda(n) : '');
        });
    })();
</script>

