@using System.Data
@model DataTable
<link href="~/Scripts/tables/jquery.dynatable.css" rel="stylesheet" />
<script type="text/javascript" src="~/Scripts/tables/jquery.dynatable.js"></script>


<table class="ui selectable celled table ui center aligned tablesInitial" id="tblDatos">
    <thead>
        <tr>
            @foreach (System.Data.DataColumn col in Model.Columns)
            {
                <th data-dynatable-column="@col.ColumnName">@col.ColumnName</th>
            }
            <th data-dynatable-column="documentar"
                data-dynatable-no-sort="true">documentar</th>
        </tr>
        }
           
            <tr>
                <td>
                    @Html.DropDownList("cbxGDS", (SelectList)ViewBag.GDSDictionary, "[-Seleccione una opción-]", new { @class = "ui search dropdown", @id = "cbxGDS" })
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                    @Html.DropDownList("cbxTiqueteador", (SelectList)ViewBag.TiqueteadorDictionary, "[-Seleccione una opción-]", new { @class = "ui search dropdown", @id = "cbxTiqueteador" })
                </td>
            </tr>
        </thead>


    <tbody>


        @foreach (System.Data.DataRow row in Model.Rows)
        {
            <tr data-origen="@row["Origen"]"
                data-value="@row["Tiqueteador"]">
                @foreach (System.Data.DataColumn col in Model.Columns)
                {
                    <td>@row[col.ColumnName]</td>
                }
                <td></td>
            </tr>
        }

    </tbody>
</table>



<div class="ui card cardTest" style="display:none">
    @*<div class="image icon">
           <i class="teal huge file pdf outline icon"></i>

        </div>*@
    <div class="content">
        Informe:  <a href="" id="pdfref" target="_blank">
            <i id="number"></i>
        </a>
        <div class="meta">
            <i id="datefile"></i>
        </div>
        <div class="description">
            <i id="type"></i>
        </div>
    </div>
</div>
<div class="content">
    <div class="renderImages ui cards" style="display:none"></div>
</div>




<script type="text/javascript">

    $(function () {
        var $tabla = $('#tblDatos');

        function normalizar(valor) {
            return valor == null
                ? ''
                : String(valor).trim().toLowerCase();
        }

        // Las claves coinciden con data-dynatable-column del encabezado.
        var columnas = $tabla.find('thead tr:first th').map(function () {
            return $(this).attr('data-dynatable-column');
        }).get();

        // Leer las filas originales antes de inicializar Dynatable.
        var registros = $tabla.find('tbody tr').map(function () {
            var $fila = $(this);
            var registro = {};

            $fila.children('td').each(function (indice) {
                if (indice < columnas.length) {
                    registro[columnas[indice]] = $(this).html();
                }
            });

            // Estos campos se usan para filtrar, no agregan columnas.
            registro._filtroOrigen = normalizar($fila.attr('data-origen'));
            registro._filtroTiqueteador = normalizar($fila.attr('data-value'));

            return registro;
        }).get();

        // Conservar tu callback si está definido.
        if (typeof processingComplete === 'function') {
            $tabla.on('dynatable:afterProcess', processingComplete);
        }

        var dynatable = $tabla.dynatable({
            table: {
                // Excluir la segunda fila, que contiene los filtros.
                headRowSelector: 'thead tr:first'
            },
            dataset: {
                records: registros
            }
        }).data('dynatable');

        function leerSeleccion(selector) {
            var $select = $(selector);

            return {
                valor: normalizar($select.val()),
                texto: normalizar($select.find('option:selected').text())
            };
        }

        function coincide(dato, seleccion) {
            // Mantiene tu convención: "" y "0" significan todos.
            if (seleccion.valor === '' || seleccion.valor === '0') {
                return true;
            }

            return dato === seleccion.valor || dato === seleccion.texto;
        }

        // Una sola consulta combina los dos filtros.
        dynatable.queries.functions.filtrosCombinados = function (registro, filtros) {
            return coincide(registro._filtroOrigen, filtros.origen)
                && coincide(registro._filtroTiqueteador, filtros.tiqueteador);
        };

        function aplicarFiltros() {
            dynatable.queries.add('filtrosCombinados', {
                origen: leerSeleccion('#cbxGDS'),
                tiqueteador: leerSeleccion('#cbxTiqueteador')
            });

            dynatable.settings.dataset.page = 1;
            dynatable.process();
        }

        $('#cbxGDS, #cbxTiqueteador').on('change', aplicarFiltros);

        aplicarFiltros();
    });

    function cargarElement(url) {
      console.log("Cargando elemento desde URL: " + url);

      $.ajax({
          url: url,


          beforeSend: function () {
              $('#facadeContent').html('').addClass("loading").css("height", 500);
          },
          success: function (data) {
              $('#facadeContent').html(data);
              $('.titlesPages').html('@ViewBag.ApplicationName | ' + $('.titlesPages').html());
          },
          complete: function () {
              $('#facadeContent').removeClass("loading").css("height", "inherit");
              LoadElementsDefaultPartial('#facadeContent');
          }
      })
    }


    var $element = $('.cardTest');
    LoadTables();
    function getDetailTechReports(pdfs, type) {
        $('.renderImages').html('');
        $element.find($('#number').text(pdfs));
        $element.find($('#pdfref').attr('href', '../../PROCEDURE_reports/' + pdfs));
        $element.find($('#type').text(type));
        $('.renderImages').append('<div class="ui card cardTest"> ' + $element.html() + '</div>');
        $('.renderImages').show('slow');
    }
</script>