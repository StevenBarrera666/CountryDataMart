@using System.Data
@model DataTable
<link href="~/Scripts/tables/jquery.dynatable.css" rel="stylesheet" />
<script type="text/javascript" src="~/Scripts/tables/jquery.dynatable.js"></script>


<table class="ui selectable celled table ui center aligned tablesInitial">
    <thead>
        <tr>
            @foreach (System.Data.DataColumn col in Model.Columns)
            {
                
                    <th>@col.ColumnName</th>
            }
            <th>documentar</th>
        </tr>
        <tr>
            <td>
            @Html.DropDownList("cbxGDS", (SelectList)ViewBag.GDSDictionary, "[-Seleccione una opción-]", new { @class = "ui search dropdown", @id = "cbxGDS" })
            </td>
        </tr>
    </thead>
    <tbody>
         
        @foreach (System.Data.DataRow row in Model.Rows)
        {
            <tr data-origen="@row["Origen"].ToString()">
                @foreach (DataColumn col in Model.Columns)
                {
                    @*<td>@row[col.ColumnName]</td>*@
                    @Html.DropDownList("cbxGDS", (SelectList)ViewBag.GDSDictionary, "[-Seleccione una opción-]", new { @class = "ui search dropdown", @id = "cbxMedio" })

                }
                <td>
                    @*redirect a otra vista
            Mostrar otra vista y pasarle @row[col.ColumnName] como parametro y el id de la columa Numero Expediente @row["Numero Expediente"]*@
                    <a href="javascript:void(0)" onclick="cargarElement('@Url.Action("CompletarInfo",new { @NoExpediente=row["Numero Expediente"].ToString()})')">Pasar a Documentar</a>
                </td>
            </tr>
            ;
        }
    </tbody>
</table>
<br />


<div class="ui card cardTest" style="display:none">
    @*<div class="image icon">
           <i class="teal huge file pdf outline icon"></i>

        </div>*@
    <div class="content">
        Informe:  <a href="" id="pdfref" target="_blank">
            <i id="number"></i>
        </a>
        <div class="meta">
            <i id="datefile"></i>
        </div>
        <div class="description">
            <i id="type"></i>
        </div>
    </div>
</div>
<div class="content">
    <div class="renderImages ui cards" style="display:none"></div>
</div>




<script type="text/javascript">

    $(document).ready(function () {
        $('#cbxGDS').on('change', function () {

            
            // Obtener el texto o valor seleccionado (convertido a minúsculas para comparar fácilmente)
            var valorSeleccionado = $(this).val().toString().trim().toLowerCase();
            var textoSeleccionado = $(this).find('option:selected').text().trim().toLowerCase();


            console.log(valorSeleccionado);
            console.log(textoSeleccionado);
            // Recorrer todas las filas del tbody de la tabla
            $('#tblDatos tbody tr').each(function () {
                var origenFila = $(this).data('origen').toString().trim().toLowerCase();

                // Si la opción seleccionada es la vacía/defecto, muestra todas las filas
                if (valorSeleccionado === "" || valorSeleccionado === "0") {
                    $(this).show();
                } else {
                    // Compara el valor de data-origen con el valor o texto del dropdown
                    if (origenFila === valorSeleccionado || origenFila === textoSeleccionado) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                }
            });
        });
    });

    function cargarElement(url) {
      console.log("Cargando elemento desde URL: " + url);

      $.ajax({
          url: url,


          beforeSend: function () {
              $('#facadeContent').html('').addClass("loading").css("height", 500);
          },
          success: function (data) {
              $('#facadeContent').html(data);
              $('.titlesPages').html('@ViewBag.ApplicationName | ' + $('.titlesPages').html());
          },
          complete: function () {
              $('#facadeContent').removeClass("loading").css("height", "inherit");
              LoadElementsDefaultPartial('#facadeContent');
          }
      })
    }


    var $element = $('.cardTest');
    LoadTables();
    function getDetailTechReports(pdfs, type) {
        $('.renderImages').html('');
        $element.find($('#number').text(pdfs));
        $element.find($('#pdfref').attr('href', '../../PROCEDURE_reports/' + pdfs));
        $element.find($('#type').text(type));
        $('.renderImages').append('<div class="ui card cardTest"> ' + $element.html() + '</div>');
        $('.renderImages').show('slow');
    }
</script>