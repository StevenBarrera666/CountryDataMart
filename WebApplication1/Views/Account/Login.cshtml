@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<div class="login-page">
    @using (Ajax.BeginForm(
        "ValidateLogin",
        "Account",
        null,
        new AjaxOptions
        {
            OnBegin = "OnBeginLogin()",
            OnSuccess = "OnSuccessLogin(data)",
            OnFailure = "OnError(xhr)",
            HttpMethod = "POST"
        },
        new
        {
            id = "formLogin",
            @class = "login-container"
        }
    ))
    {
        <!-- Sección de marca -->
       

        <!-- Sección del formulario -->
        <section class="login-form-section">
            <div class="login-card">

                <div class="login-avatar">
                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="currentColor"
                         aria-hidden="true"
                         class="login-avatar-icon">
                        <path fill-rule="evenodd"
                              clip-rule="evenodd"
                              d="M18.685 19.097A9.723 9.723 0 0 0 21.75 12c0-5.385-4.365-9.75-9.75-9.75S2.25 6.615 2.25 12a9.723 9.723 0 0 0 3.065 7.097A9.716 9.716 0 0 0 12 21.75a9.716 9.716 0 0 0 6.685-2.653Zm-12.54-1.285A7.486 7.486 0 0 1 12 15a7.486 7.486 0 0 1 5.855 2.812A8.224 8.224 0 0 1 12 20.25a8.224 8.224 0 0 1-5.855-2.438ZM15.75 9a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
                    </svg>
                </div>

                <header class="login-header">
                    <h1 class="login-title">
                        Iniciar sesión
                    </h1>

                    <p class="login-subtitle">
                        Bienvenido de vuelta
                    </p>
                </header>

                <div class="login-fields">

                    <!-- Campo de usuario -->
                    <div class="login-field">
                        <label for="nameUser" class="login-label">
                            Usuario
                        </label>

                        <div class="login-input-container">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.5"
                                 aria-hidden="true"
                                 class="login-input-icon">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.25a7.5 7.5 0 0 1 15 0" />
                            </svg>

                            <input type="text"
                                   name="nameUser"
                                   id="nameUser"
                                   class="login-input"
                                   placeholder="Usuario"
                                   autocomplete="username"
                                   required />
                        </div>
                    </div>

                    <!-- Campo de contraseña -->
                    <div class="login-field">
                        <label for="password" class="login-label">
                            Contraseña
                        </label>

                        <div class="login-input-container">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.5"
                                 aria-hidden="true"
                                 class="login-input-icon">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M16.5 10.5V6.75a4.5 4.5 0 0 0-9 0v3.75m-.75 0h10.5A2.25 2.25 0 0 1 19.5 12.75v6A2.25 2.25 0 0 1 17.25 21H6.75a2.25 2.25 0 0 1-2.25-2.25v-6a2.25 2.25 0 0 1 2.25-2.25Z" />
                            </svg>

                            <input type="password"
                                   name="password"
                                   id="password"
                                   class="login-input"
                                   placeholder="Contraseña"
                                   autocomplete="current-password"
                                   required />
                        </div>
                    </div>

                    <button type="submit"
                            id="btnIniciarSesion"
                            class="login-button">
                        Iniciar sesión
                    </button>

                    <div id="messageResultLogin"
                         class="login-message"
                         role="alert"
                         aria-live="polite">
                    </div>
                </div>
            </div>
        </section>
    }
</div>

<script type="text/javascript">
    var message = '<div class="header">¡!</div>{message}';

    $(function () {
        $('#messageResultLogin').hide();
    });

    function OnBeginLogin() {
        $('#messageResultLogin').hide();

        $.LoadingOverlay("show", {
            image: "",
            fontawesome: "fa fa-spinner fa-pulse",
            backgroundColor: "rgba(14, 12, 12, 0.7)",
            color: "rgba(255, 255, 255, 0.8)"
        });
    }

    function OnError(xhr) {
        setTimeout(function () {
            $.LoadingOverlay("hide");

            $('#messageResultLogin')
                .html(message.replace("{message}", "Ha ocurrido un error"))
                .show("slow");
        }, 2000);
    }

    function OnSuccessLogin(data) {
        $.LoadingOverlay("hide");

        $('#messageResultLogin')
            .html(message.replace("{message}", data.message))
            .show("slow");

        if (data.result) {
            setTimeout(function () {
                location.href = data.url;
            }, 3000);
        }
    }
</script>