
@using WebApplication1.Models;
@{
    var session = Session["SessionUser"] as SessionModels;
}
<!DOCTYPE html>
<html lang="es" class="h-full text-[24px]">
<head>  
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - Viajes Country - Datamart</title>

    <link href="@Url.Content("~/Content/Bootstrap/css/bootstrap.min.css")"
          rel="stylesheet"
          type="text/css" />


    <link rel="stylesheet"
          href="@Url.Content("~/Content/stylesLogin/Layaud.css")" />

    <style>
        body {
            background-repeat: no-repeat;
            background-size: cover;
            background-position: center;
            min-height: 100vh;
            margin: 0;
        }
    </style>

</head>
<body class="m-0 min-h-screen bg-slate-950 text-white" style="display:flex;justify-content:center; align-items:center">

    @RenderBody()




    @Scripts.Render("~/bundles/jqueryJs")
    @Scripts.Render("~/bundles/semanticJs")
    @Scripts.Render("~/Content/LoadingOverlay/src/loadingoverlay.min.js")
    @Scripts.Render("~/bundles/jqueryUnobstriveJs")
    @RenderSection("scripts", required: false)
    <script type="text/javascript">
        function alturas() {
             var link = '@Url.Action("Index", "Home", new { modulo = "WH" })';

        location.href = link;
        }


    </script>
</body>
</html>
<script src="~/Content/Bootstrap/js/bootstrap.bundle.min.js"></script>

