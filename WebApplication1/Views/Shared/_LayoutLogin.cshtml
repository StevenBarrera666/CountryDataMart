<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Viajes Country- Datamart</title>
    @Styles.Render("~/Content/SemanticUi/semantic.css")
    @Styles.Render("~/Content/Site.css")
    @Styles.Render("~/Content/font-awesome-4.7.0/css/font-awesome.css")

  

    <link rel="stylesheet"
          href="@Url.Content("~/Content/stylesLogin/login.css")" />



    <style>
        body {
            background-image: url('@Url.Content("~/Content/Images/fondoNuevo.png")');
            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;

        }
    </style>
</head>
<body>
    @RenderBody()

    @Scripts.Render("~/bundles/jqueryJs")
    @Scripts.Render("~/bundles/semanticJs")
    @Scripts.Render("~/Content/LoadingOverlay/src/loadingoverlay.min.js")
    @Scripts.Render("~/bundles/jqueryUnobstriveJs")
    @RenderSection("scripts", required: false)
</body>
</html>