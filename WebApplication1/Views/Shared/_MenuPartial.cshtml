@using WebApplication1.Models;
@{
    var session = Session["SessionUser"] as SessionModels;
}
@{
    ViewBag.ApplicationName = "PROGRAMA DE PROTECCIÓN CONTRA CAÍDAS";
}
<!-- menu styles -->
<link href="~/Scripts/MultiLevelMenu/css/component.css" rel="stylesheet" />

<script src="~/Scripts/MultiLevelMenu/js/modernizr-custom.js"></script>

<button class="action action--open" aria-label="Open Menu"><span class="icon icon--menu"></span></button>
<nav id="ml-menu" class="menuMult" style="margin-top:-1%">
    <button class="action action--close" aria-label="Close Menu"><span class="icon icon--cross"></span></button>
    <div class="menu__wrap">
        @if (@session.RolId == 1)
        {
            <ul data-menu="main" class="menu__level">
                <li class="menu__item">
                    <a class="menu__link" href="@Url.Action("Index", "Home")" data-reload="true">
                        <i class="fa fa-home" aria-hidden="true"></i> Inicio
                    </a>
                </li>
                <li class="menu__item">
                    <a class="menu__link" data-submenu="submenu-1" href="javascript:void(0)">
                        <i class="fa fa-address-book" aria-hidden="true"></i> Programa Alturas
                    </a>
                </li>

            </ul>
            <!-- Submenu 1 -->
            <ul data-menu="submenu-1" class="menu__level">
                <li class="menu__item"><a class="menu__link" href="@Url.Action("ProceduresReportsIndex", "Inspections")">Procedimientos</a></li>
                <li class="menu__item"><a class="menu__link" href="@Url.Action("FormatsReportsIndex", "Inspections")">Formatos</a></li>
                <li class="menu__item"><a class="menu__link" href="@Url.Action("CertificatesReportsIndex", "Inspections")">Certificados de proveedores</a></li>
                <li class="menu__item"><a class="menu__link" href="@Url.Action("LegalityReportsIndex", "Inspections")">Normatividad</a></li>
                <li class="menu__item"><a class="menu__link" href="@Url.Action("Features", "Inspections")">Cargar Documentos</a></li>
            </ul>
        }
    </div>
</nav>
<script src="~/Scripts/MultiLevelMenu/js/classie.js"></script>
<script src="~/Scripts/MultiLevelMenu/js/dummydata.js"></script>
<script src="~/Scripts/MultiLevelMenu/js/main.js"></script>
<script>
    (function () {
        var menuEl = document.getElementById('ml-menu'),

			mlmenu = new MLMenu(menuEl, {
			    // breadcrumbsCtrl : true, // show breadcrumbs
			    // initialBreadcrumb : 'all', // initial breadcrumb text
			    backCtrl: true, // show back button
			    // itemsDelayInterval : 60, // delay between each menu item sliding animation
			    onItemClick: loadDummyData // callback: item that doesn´t have a submenu gets clicked - onItemClick([event], [inner HTML of the clicked item])
			});

        // mobile menu toggle
        var openMenuCtrl = document.querySelector('.action--open'),
			closeMenuCtrl = document.querySelector('.action--close');

        openMenuCtrl.addEventListener('click', openMenu);
        closeMenuCtrl.addEventListener('click', closeMenu);

        function openMenu() {
            classie.add(menuEl, 'menu--open');
        }

        function closeMenu() {
            classie.remove(menuEl, 'menu--open');
        }

        // simulate grid content loading
        var gridWrapper = document.querySelector('.content');

        function loadDummyData(ev, itemName) {

            ev.preventDefault();
            closeMenu();
            if ($(ev.srcElement).data("finish")) {
                location.href = '@Url.Action("LogOff","Account")';
            } else if ($(ev.srcElement).data("reload")) {
                location.reload();
            } else {
                if (ev.srcElement.href != "#" && ev.srcElement.href != "javascript:void(0)") {
                    cargarElement(ev.srcElement.href);
                }

            }

        }
    })();
    function cargarElement(url) {
        $.ajax({
            url: url,
            beforeSend: function () {
                $('#renderPages').html('').addClass("loading").css("height", 500);
            },
            success: function (data) {
                $('#renderPages').html(data);
                $('.titlesPages').html('@ViewBag.ApplicationName | ' + $('.titlesPages').html());
            },
            complete: function () {
                $('#renderPages').removeClass("loading").css("height", "inherit");
                LoadElementsDefaultPartial('#renderPages');
                $("#menuPartial").hide();
            }
        })
    }
    function LoadElementsDefaultPartial(element) {
        $(element).find($('.ui.dropdown').dropdown());
        $(element).find($('.ui.checkbox').checkbox());
    }
</script>