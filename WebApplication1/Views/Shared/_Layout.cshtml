    @* ============================================
        ESTILOS TEMPORALES DEL LAYOUT
        Después podemos moverlos a un CSS
        ============================================ *@

    <style>

        body {

            background-image:
                url('@Url.Content("~/Content/Images/robotica-dighe_1200x630.jpeg")');

            background-repeat: no-repeat;

            background-size: cover;

        }


        .card-header .fa {

            transition:
                .3s transform ease-in-out;

        }


        .card-header .collapsed .fa {

