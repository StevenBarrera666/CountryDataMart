        CONTENEDOR PRINCIPAL DEL LAYOUT
        ============================================ *@

    <div class="main" style="margin:0; ">


        @* ========================================
            ZONA SUPERIOR / MENÚ
            ======================================== *@

        <div class="ui equal width form">


            @* ====================================
                MENÚ DINÁMICO SEGÚN SESIÓN
                ==================================== *@

            <div class="fields">


                @if (session != null &&
